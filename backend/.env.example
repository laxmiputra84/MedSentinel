# =====================================================
# APPLICATION
# =====================================================

APP_NAME=MedSentinel
ENVIRONMENT=development
DEBUG=true


# =====================================================
# DATABASE
# =====================================================

DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/medsentinel
TEST_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/medsentinel_test

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600


# =====================================================
# JWT SECURITY
# =====================================================

JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# =====================================================
# CORS
# =====================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =====================================================
# ENTERPRISE AI & LLM PROVIDER
# =====================================================

AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
STRICT_PRIVATE_MODE=true
ENABLE_DATASET_REVIEW=true

AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100


# =====================================================
# RAG & VECTOR DATABASE
# =====================================================

RAG_ENABLED=true
VECTOR_DB_PROVIDER=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=medsentinel_knowledge

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004


# =====================================================
# FILE UPLOADS & DATASETS
# =====================================================

UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=25


# =====================================================
# TWILIO SMS (OPTIONAL)
# =====================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# =====================================================
# ADMIN SETTINGS
# =====================================================

ADMIN_ANALYTICS_CACHE_SECONDS=300
ENABLE_ADMIN_AUDIT_LOGS=true
