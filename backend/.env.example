# =====================================================
# APPLICATION
# =====================================================

APP_NAME=MedSentinel
ENVIRONMENT=development
DEBUG=true


# =====================================================
# DATABASE
# =====================================================

DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/medsentinel
TEST_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/medsentinel_test

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600


# =====================================================
# JWT SECURITY
# =====================================================

JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# =====================================================
# CORS
# =====================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =====================================================
# ENTERPRISE AI & LLM PROVIDER
# =====================================================

AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
STRICT_PRIVATE_MODE=true
ENABLE_DATASET_REVIEW=true

AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100


# =====================================================
# RAG & VECTOR DATABASE
# =====================================================

RAG_ENABLED=true
VECTOR_DB_PROVIDER=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=medsentinel_knowledge

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004


# =====================================================
# FILE UPLOADS & DATASETS
# =====================================================

UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=25


# =====================================================
# TWILIO SMS (OPTIONAL)
# =====================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# =====================================================
# ADMIN SETTINGS
# =====================================================

ADMIN_ANALYTICS_CACHE_SECONDS=300
ENABLE_ADMIN_AUDIT_LOGS=true


# =====================================================
# AGENTIC PLUGIN & INTEGRATION HUB
# =====================================================

# WhatsApp Business Cloud API
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=medsentinel_whatsapp_webhook_token
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Mobile SMS & OTP (Twilio / AWS SNS / Infobip)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_sid_here
SMS_AUTH_TOKEN=your_twilio_auth_token_here
SMS_SENDER_NUMBER=+1234567890
SMS_WEBHOOK_SECRET=your_sms_webhook_secret_here

# Telephony / Voice (Twilio Voice / Exotel / Vonage)
VOICE_PROVIDER=twilio
VOICE_ACCOUNT_SID=your_voice_sid_here
VOICE_AUTH_TOKEN=your_voice_auth_token_here
VOICE_CALLER_ID=+1234567890
VOICE_WEBHOOK_SECRET=your_voice_webhook_secret_here

# Gmail OAuth 2.0 Integration
GMAIL_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GMAIL_MINIMAL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# Universal Enterprise Email (SMTP / SendGrid / Exchange)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hospital-mail.org
SMTP_PORT=587
SMTP_USER=notifications@medsentinel.io
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM="MedSentinel Clinical Center <notifications@medsentinel.io>"

# Cloud Storage (AWS S3 / Google Drive / OneDrive / MinIO)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=medsentinel-encrypted-vault-prod
S3_ENDPOINT_URL=

# Calendar API (Google Calendar / Microsoft Graph / CalDAV)
CALENDAR_PROVIDER=google
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=

# Hospital Systems (FHIR / HL7 / EMR API)
HOSPITAL_API_BASE_URL=https://api.hospital-network.org/fhir/r4
HOSPITAL_API_CLIENT_ID=
HOSPITAL_API_CLIENT_SECRET=
HOSPITAL_API_TIMEOUT_SECONDS=15

# Insurance Payer Gateway (TPA / National Health Authority)
INSURANCE_API_BASE_URL=https://claims.tpa-network.org/v2
INSURANCE_API_KEY=
INSURANCE_API_SECRET=
INSURANCE_APPROVAL_MANDATORY=true

# Payment Gateway (Stripe / Razorpay / PayPal)
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Secret Management & Encryption
ENCRYPTION_KEY_AES256=CHANGE_THIS_TO_32_BYTE_HEX_IN_PRODUCTION
SSRF_ALLOWED_DOMAINS=.gov,.org,.com,.io,.net,.health,.ai
